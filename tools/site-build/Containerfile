FROM python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72

ARG HUGO_VERSION=0.169.0
ARG HUGO_SHA256_AMD64=2d2f0bfe357d8cb4cec02f6bb28a3bff34978c8dda44b618029c5eb9d66765a7
ARG HUGO_SHA256_ARM64=ddadaaccbf437e3d39c33140b80c2180c4f46d027d16b7716c1282ea2e14e00c

RUN python3 - <<'PY'
import hashlib
import io
import os
import platform
import tarfile
import urllib.request
from pathlib import Path

arch = {"x86_64": "amd64", "aarch64": "arm64"}[platform.machine()]
version = os.environ["HUGO_VERSION"]
url = f"https://github.com/gohugoio/hugo/releases/download/v{version}/hugo_{version}_linux-{arch}.tar.gz"
with urllib.request.urlopen(url, timeout=60) as response:
    archive = response.read()
expected = os.environ[f"HUGO_SHA256_{arch.upper()}"]
if hashlib.sha256(archive).hexdigest() != expected:
    raise SystemExit("Hugo archive checksum mismatch")
with tarfile.open(fileobj=io.BytesIO(archive), mode="r:gz") as bundle:
    executable = bundle.extractfile("hugo")
    if executable is None:
        raise SystemExit("Hugo binary missing from archive")
    target = Path("/usr/local/bin/hugo")
    target.write_bytes(executable.read())
    target.chmod(0o755)
PY

ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /site
CMD ["hugo", "version"]
